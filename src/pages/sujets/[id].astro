---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';

export async function getStaticPaths() {
  const subjects = await getCollection('subjects', ({ data }) => !data.draft);
  return subjects.map((subject) => ({ params: { id: subject.id }, props: { subject } }));
}

const { subject } = Astro.props;
const { Content } = await render(subject);

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .filter((project) => project.data.subject.id === subject.id)
  // Les rendus mis en avant d'abord, puis du plus récent au plus ancien.
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year);
---

<Base title={`${subject.data.title} · Galerie de rendu en design d’interface`} description={subject.data.brief}>
  <article class="subject shell">
    <header class="subject__head">
      <p class="mono" data-reveal>
        <a href="/">Accueil</a> <span aria-hidden="true">/</span> {subject.data.title}
      </p>
      <h1 class="subject__title" data-reveal data-reveal-delay="0.06">{subject.data.title}</h1>
      <p class="subject__brief" data-reveal data-reveal-delay="0.12">{subject.data.brief}</p>
      <div class="subject__body prose" data-reveal data-reveal-delay="0.18">
        <Content />
      </div>
      {
        subject.data.tags.length > 0 && (
          <ul class="tags" data-reveal data-reveal-delay="0.22">
            {subject.data.tags.map((tag) => (
              <li class="mono">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <ProjectGrid projects={projects} />

  </article>

  <script>
    import { initReveal } from '../../scripts/reveal';
    initReveal();
  </script>

  <style>
    .subject {
      padding-block: clamp(3rem, 10vh, 6rem) 0;
    }

    .subject__head a {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    .subject__title {
      margin-block: 0.35em 0.3em;
      font-size: var(--step-4);
      font-weight: 500;
      line-height: 0.94;
      letter-spacing: -0.045em;
      font-variation-settings: 'wght' 500, 'wdth' 88;
    }

    .subject__brief {
      font-size: var(--step-2);
      line-height: 1.3;
      letter-spacing: -0.02em;
      text-wrap: pretty;
    }

    .prose {
      margin-top: 2rem;
      color: var(--muted);
      text-wrap: pretty;
    }

    /* Les deux paragraphes se touchaient : Markdown produit des <p>, mais
       aucune marge ne les séparait sur cette page. */
    .prose :global(p + p) {
      margin-top: 1em;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 2rem;
    }

    .subject__head {
      max-width: 58rem;
      margin-bottom: clamp(3.5rem, 10vh, 6rem);
    }
    .tags li {
      padding: 0.3rem 0.7rem;
      border: var(--rule) solid var(--line);
      border-radius: 999px;
    }

  </style>
</Base>
