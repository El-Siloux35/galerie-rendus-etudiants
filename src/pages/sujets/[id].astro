---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const subjects = await getCollection('subjects', ({ data }) => !data.draft);
  return subjects.map((subject) => ({ params: { id: subject.id }, props: { subject } }));
}

const { subject } = Astro.props;
const { Content } = await render(subject);

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .filter((project) => project.data.subject.id === subject.id)
  // Les rendus mis en avant d'abord, puis du plus récent au plus ancien.
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year);
---

<Base title={`${subject.data.title} · Galerie des rendus`} description={subject.data.brief}>
  <article class="subject shell">
    <header class="subject__head">
      <p class="mono" data-reveal>
        <a href="/">Sujets</a> → {subject.data.year}
      </p>
      <h1 class="subject__title" data-reveal data-reveal-delay="0.06">{subject.data.title}</h1>
      <p class="subject__brief" data-reveal data-reveal-delay="0.12">{subject.data.brief}</p>
      <div class="subject__body prose" data-reveal data-reveal-delay="0.18">
        <Content />
      </div>
      {
        subject.data.tags.length > 0 && (
          <ul class="tags" data-reveal data-reveal-delay="0.22">
            {subject.data.tags.map((tag) => (
              <li class="mono">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <h2 class="mono section-label">
      {projects.length} {projects.length > 1 ? 'rendus' : 'rendu'}
    </h2>

    {projects.length === 0 && <p class="empty">Aucun rendu publié pour l’instant.</p>}

    <ul class="grid">
      {
        projects.map((project, i) => (
          <li data-reveal data-reveal-delay={String(0.05 * (i % 3))}>
            <a class="card" href={`/rendus/${project.id}`}>
              <Image
                class="card__img"
                src={project.data.cover}
                alt={project.data.coverAlt}
                widths={[520, 1040]}
                sizes="(max-width: 44rem) 92vw, 30vw"
              />
              <h3 class="card__title">{project.data.title}</h3>
              <p class="card__students mono">
                {project.data.students.map((s) => s.name).join(', ')} · {project.data.class}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </article>

  <script>
    import { initReveal } from '../../scripts/reveal';
    initReveal();
  </script>

  <style>
    .subject {
      padding-block: clamp(3rem, 10vh, 6rem) 0;
    }

    .subject__head a {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    .subject__title {
      margin-block: 0.35em 0.3em;
      font-size: var(--step-4);
      font-weight: 500;
      line-height: 0.94;
      letter-spacing: -0.045em;
      font-variation-settings: 'wght' 500, 'wdth' 88;
    }

    .subject__brief {
      max-width: 42ch;
      font-size: var(--step-2);
      line-height: 1.3;
      letter-spacing: -0.02em;
      text-wrap: pretty;
    }

    .prose {
      max-width: 54ch;
      margin-top: 1.6rem;
      color: var(--muted);
      text-wrap: pretty;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 2rem;
    }
    .tags li {
      padding: 0.3rem 0.7rem;
      border: var(--rule) solid var(--line);
      border-radius: 999px;
    }

    .section-label {
      margin-block: clamp(3.5rem, 10vh, 6rem) 1.2rem;
      font-weight: 400;
    }

    .empty {
      font-size: var(--step-1);
      color: var(--muted);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
      gap: clamp(1.5rem, 3vw, 2.75rem);
    }

    .card__img {
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 2;
      object-fit: cover;
      border: var(--rule) solid var(--line);
      filter: grayscale(1) contrast(1.05);
      transition:
        transform 0.7s var(--ease),
        filter 0.6s var(--ease);
    }

    .card:hover .card__img,
    .card:focus-visible .card__img {
      transform: scale(1.02);
      filter: grayscale(0) contrast(1);
    }

    .card__title {
      margin-top: 0.9rem;
      font-size: var(--step-1);
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    .card__students {
      margin-top: 0.3rem;
      text-transform: none;
      letter-spacing: 0.01em;
    }
  </style>
</Base>
