---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';

const subjects = (await getCollection('subjects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const projects = await getCollection('projects', ({ data }) => !data.draft);

/** Vignette légère dédiée au survol : l'image d'origine fait 900 px de large. */
const preview = async (cover: ImageMetadata) =>
  (await getImage({ src: cover, width: 620, format: 'webp' })).src;

/** Un rendu représentatif d'un groupe, pour illustrer sa ligne. */
const pick = (list: typeof projects) => list.find((p) => p.data.featured) ?? list[0];

// --- Par sujet ---------------------------------------------------------
const subjectRows = await Promise.all(
  subjects.map(async (subject) => {
    const list = projects.filter((p) => p.data.subject.id === subject.id);
    const count = list.length;
    return {
      href: `/sujets/${subject.id}`,
      label: subject.data.title,
      meta: `${subject.data.year} · ${count} ${count > 1 ? 'rendus' : 'rendu'}`,
      // La vignette montre un vrai rendu du sujet. L'image du sujet ne sert
      // que tant qu'aucun travail n'a été publié dessus.
      preview: await preview(pick(list)?.data.cover ?? subject.data.cover),
    };
  }),
);

// --- Par niveau --------------------------------------------------------
const levels = [...new Set(projects.map((p) => p.data.level))].sort((a, b) => a.localeCompare(b));
const levelRows = await Promise.all(
  levels.map(async (level) => {
    const list = projects.filter((p) => p.data.level === level);
    return {
      href: `/niveaux/${level}`,
      label: level,
      meta: `${list.length} ${list.length > 1 ? 'rendus' : 'rendu'}`,
      preview: await preview(pick(list)!.data.cover),
    };
  }),
);

// --- Par année ---------------------------------------------------------
// De la plus récente à la plus ancienne : c'est le travail frais qu'on vient voir.
const years = [...new Set(projects.map((p) => p.data.year))].sort((a, b) => b - a);
const yearRows = await Promise.all(
  years.map(async (year) => {
    const list = projects.filter((p) => p.data.year === year);
    return {
      href: `/annees/${year}`,
      label: `${year}-${year + 1}`,
      meta: `${list.length} ${list.length > 1 ? 'rendus' : 'rendu'}`,
      preview: await preview(pick(list)!.data.cover),
    };
  }),
);

const lists = [
  { key: 'sujet', name: 'Par sujet', aria: 'Sujets', rows: subjectRows },
  { key: 'niveau', name: 'Par niveau', aria: 'Niveaux', rows: levelRows },
  { key: 'annee', name: 'Par année', aria: 'Années', rows: yearRows },
];

const allYears = [...new Set([...subjects.map((s) => s.data.year), ...years])].sort();
const period =
  allYears.length > 1
    ? `${allYears[0]}-${allYears.at(-1)! + 1}`
    : `${allYears[0]}-${allYears[0] + 1}`;
---

<Base title="Galerie de rendu en design d’interface">
  <!-- Vignette qui suit le curseur. Remplie en WebGL par le script ; vide
       et invisible si JS, WebGL ou le survol ne sont pas disponibles. -->
  <div class="preview" data-preview-root aria-hidden="true"></div>

  <section class="hero shell">
    <p class="mono" data-reveal>
      {period} · {subjects.length} sujets · {projects.length}{' '}
      {projects.length > 1 ? 'rendus' : 'rendu'}
    </p>
    <h1 class="hero__title" data-reveal data-reveal-delay="0.08">Ce qui sort de l’atelier</h1>

    <div class="filters" role="group" aria-label="Trier la liste" data-reveal data-reveal-delay="0.16">
      {
        lists.map((list, i) => (
          <button type="button" data-filter={list.key} aria-pressed={String(i === 0)}>
            {list.name}
          </button>
        ))
      }
    </div>
  </section>

  <div class="lists shell" data-lists>
    {
      lists.map((list, i) => (
        <nav class="subjects" data-list={list.key} aria-label={list.aria} hidden={i !== 0}>
          <ul>
            {list.rows.map((row, j) => (
              <li data-reveal data-reveal-delay={String(0.04 * j)}>
                <a href={row.href} data-preview-src={row.preview}>
                  <span class="row__title">{row.label}</span>
                  <span class="row__meta mono">{row.meta}</span>
                  <span class="row__arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
          {list.rows.length === 0 && <p class="mono empty">Rien à afficher pour l’instant.</p>}
        </nav>
      ))
    }
  </div>

  <script>
    import { initSubjectPreview } from '../scripts/subject-preview';
    import { initReveal } from '../scripts/reveal';
    import { initFilters } from '../scripts/filters';
    initReveal();
    initFilters();
    initSubjectPreview();
  </script>

  <style>
    .preview {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 20;
      width: clamp(210px, 19vw, 330px);
      aspect-ratio: 3 / 2;
      pointer-events: none;
      will-change: transform;
    }
    .preview :global(.preview__canvas) {
      width: 100%;
      height: 100%;
    }

    .hero {
      padding-block: clamp(3rem, 10vh, 6.5rem) clamp(2rem, 6vh, 3.5rem);
    }

    .hero__title {
      margin-block: 0.32em 0.5em;
      font-size: var(--step-5);
      font-weight: 500;
      line-height: 0.9;
      letter-spacing: -0.05em;
      font-variation-settings: 'wght' 500, 'wdth' 84;
      /* Répartit les mots sur des lignes de longueur égale, sans coupure
         écrite en dur : le navigateur recalcule à chaque largeur d'écran. */
      text-wrap: balance;
    }

    /* --- Filtres -------------------------------------------------------- */
    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .filters button {
      font-family: var(--font-mono);
      font-size: var(--step--1);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      background: none;
      border: var(--rule) solid var(--line);
      border-radius: 999px;
      padding: 0.55rem 1.1rem;
      cursor: pointer;
      transition:
        color 0.3s var(--ease),
        border-color 0.3s var(--ease),
        background-color 0.3s var(--ease);
    }

    .filters button:hover {
      color: var(--ink);
      border-color: var(--line-strong);
    }

    /* L'état actif s'inverse : c'est le seul aplat plein de la page, donc
       il se repère sans couleur. */
    .filters button[aria-pressed='true'] {
      color: var(--paper);
      background: var(--ink);
      border-color: var(--ink);
    }

    /* --- Les lignes ----------------------------------------------------- */
    .subjects ul {
      border-bottom: var(--rule) solid var(--line);
    }

    .subjects a {
      position: relative;
      isolation: isolate;
      display: grid;
      grid-template-columns: 1fr auto auto;
      align-items: center;
      gap: clamp(0.9rem, 3.5vw, 3rem);
      padding-block: clamp(1rem, 2.4vw, 1.9rem);
      border-top: var(--rule) solid var(--line);
      overflow: hidden;
    }

    /* Le survol remplit la ligne depuis la gauche, comme un trait de plume. */
    .subjects a::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background: var(--veil);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.6s var(--ease);
    }
    .subjects a:hover::before,
    .subjects a:focus-visible::before {
      transform: scaleX(1);
    }

    .row__title {
      font-size: var(--step-3);
      font-weight: 500;
      line-height: 1.02;
      letter-spacing: -0.035em;
      font-variation-settings: 'wght' 500, 'wdth' 88;
      transition:
        transform 0.65s var(--ease),
        font-variation-settings 0.65s var(--ease);
    }

    .row__meta {
      white-space: nowrap;
    }

    .row__arrow {
      font-size: var(--step-1);
      color: var(--faint);
      transition:
        transform 0.65s var(--ease),
        color 0.4s var(--ease);
    }

    /* L'axe de largeur de la variable fait le travail : le titre s'élargit
       au lieu de simplement grossir, et la ligne ne saute pas. */
    .subjects a:hover .row__title,
    .subjects a:focus-visible .row__title {
      transform: translateX(clamp(0.4rem, 1.5vw, 1.5rem));
      font-variation-settings: 'wght' 500, 'wdth' 112;
    }
    .subjects a:hover .row__arrow,
    .subjects a:focus-visible .row__arrow {
      transform: translateX(0.45rem);
      color: var(--ink);
    }

    .empty {
      padding-block: 2rem;
    }

    /* Le survol d'une ligne met les autres en retrait. */
    @media (hover: hover) {
      .subjects ul:has(a:hover) li:not(:hover) {
        opacity: 0.32;
      }
      .subjects li {
        transition: opacity 0.5s var(--ease);
      }
    }

    @media (max-width: 44rem) {
      .subjects a {
        grid-template-columns: 1fr;
        row-gap: 0.35rem;
      }
      .row__arrow {
        display: none;
      }
    }
  </style>
</Base>
