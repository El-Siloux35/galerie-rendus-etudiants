---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const subject = await getEntry(project.data.subject);

// Navigation entre les rendus du même sujet, pour ne pas obliger
// à repasser par la page du sujet.
const siblings = (await getCollection('projects', ({ data }) => !data.draft))
  .filter((p) => p.data.subject.id === project.data.subject.id)
  .sort((a, b) => a.id.localeCompare(b.id));
const position = siblings.findIndex((p) => p.id === project.id);
const next = siblings[(position + 1) % siblings.length];
---

<Base
  title={`${project.data.title} · ${subject!.data.title}`}
  description={project.data.students.map((s) => s.name).join(', ')}
>
  <article class="project shell">
    <header class="project__head">
      <p class="mono" data-reveal>
        <a href="/">Sujets</a> → <a href={`/sujets/${subject!.id}`}>{subject!.data.title}</a> →{' '}
        {project.data.year}
      </p>
      <h1 class="project__title" data-reveal data-reveal-delay="0.06">{project.data.title}</h1>

      <!-- La classe est celle du groupe au moment du projet. Elle n'est
           répétée sous un nom que si cet étudiant vient d'une autre classe. -->
      <div class="credits" data-reveal data-reveal-delay="0.12">
        <ul class="credits__names">
          {
            project.data.students.map((student) => (
              <li>
                {student.name}
                {student.class && student.class !== project.data.class && (
                  <span class="credits__other mono">{student.class}</span>
                )}
              </li>
            ))
          }
        </ul>
        <p class="mono credits__class">{project.data.class}</p>
      </div>
    </header>

    <Image
      class="project__cover"
      src={project.data.cover}
      alt={project.data.coverAlt}
      widths={[720, 1440]}
      sizes="(max-width: 60rem) 92vw, 70rem"
      data-reveal
    />

    <div class="project__text prose" data-reveal>
      <Content />
    </div>

    {
      project.data.media.length > 0 && (
        <section class="project__media">
          <h2 class="mono section-label">Le rendu</h2>
          <div class="media-stack">
            {project.data.media.map((item) => (
              <div data-reveal>
                <Media item={item} />
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      next && next.id !== project.id && (
        <a class="next" href={`/rendus/${next.id}`}>
          <span class="mono">Rendu suivant</span>
          <span class="next__title">{next.data.title}</span>
        </a>
      )
    }
  </article>

  <script>
    import { initReveal } from '../../scripts/reveal';
    import { initPdfViewers } from '../../scripts/pdf-viewer';
    initReveal();
    initPdfViewers();
  </script>

  <style>
    /* La page d'un rendu est la seule à se centrer : c'est du texte suivi,
       pas un index. Le reste du site reste pleine largeur. */
    .project {
      max-width: 72rem;
      margin-inline: auto;
      padding-block: clamp(3rem, 10vh, 6rem) 0;
    }

    .project__head a {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    .project__title {
      margin-block: 0.35em 0.5em;
      font-size: var(--step-4);
      font-weight: 500;
      line-height: 0.94;
      letter-spacing: -0.045em;
      font-variation-settings: 'wght' 500, 'wdth' 88;
    }

    .credits__names {
      display: flex;
      flex-wrap: wrap;
      gap: 0.15rem 2.5rem;
      font-size: var(--step-1);
      letter-spacing: -0.015em;
    }
    .credits__other {
      margin-left: 0.5rem;
      color: var(--muted);
    }
    .credits__class {
      margin-top: 0.35rem;
    }

    .project__cover {
      width: 100%;
      /* La source est au format portrait : on recadre pour que la
         couverture n'occupe pas deux écrans de haut. */
      aspect-ratio: 16 / 10;
      max-height: 78svh;
      object-fit: cover;
      margin-top: clamp(2.5rem, 7vh, 4.5rem);
      border: var(--rule) solid var(--line);
    }

    /* Le texte garde une longueur de ligne lisible (45 à 75 signes) et se
       centre dans la page : le blanc se répartit en deux marges égales au
       lieu de laisser un bord droit inachevé. La couverture et les médias
       restent pleine largeur, ce qui donne le rythme large / étroit / large. */
    .prose {
      /* 50ch et non 65 : `ch` mesure la largeur du zéro, plus large que
         la moyenne des lettres, donc 50ch donne bien ~65 signes à l'œil. */
      max-width: 50ch;
      margin-inline: auto;
      margin-top: clamp(2.5rem, 8vh, 5rem);
      font-size: var(--step-1);
      line-height: 1.55;
      color: var(--muted);
      text-wrap: pretty;
    }
    .prose :global(p + p) {
      margin-top: 1em;
    }

    .section-label {
      margin-block: clamp(3.5rem, 10vh, 6rem) 1.5rem;
      font-weight: 400;
    }

    @media (max-width: 52rem) {
      .prose {
        margin-inline: 0;
      }
    }

    .media-stack {
      display: grid;
      gap: clamp(2.5rem, 7vh, 4.5rem);
    }

    .next {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      margin-top: clamp(4rem, 12vh, 8rem);
      padding-block: 2rem;
      border-top: var(--rule) solid var(--line-strong);
    }
    .next__title {
      font-size: var(--step-2);
      font-weight: 500;
      letter-spacing: -0.03em;
      font-variation-settings: 'wght' 500, 'wdth' 90;
      transition: font-variation-settings 0.6s var(--ease);
    }
    .next:hover .next__title {
      font-variation-settings: 'wght' 500, 'wdth' 112;
    }
  </style>
</Base>
