---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  const levels = [...new Set(projects.map((p) => p.data.level))];
  return levels.map((level) => ({
    params: { level },
    props: { level, projects: projects.filter((p) => p.data.level === level) },
  }));
}

const { level, projects } = Astro.props;
const sorted = projects.sort(
  (a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title),
);
const classes = [...new Set(sorted.map((p) => p.data.class))].sort();
---

<Base title={`${level} · Galerie de rendu en design d’interface`}>
  <article class="listing shell">
    <header>
      <p class="mono" data-reveal>
        <a href="/#niveau">Accueil</a> <span aria-hidden="true">/</span> {level}
      </p>
      <h1 class="listing__title" data-reveal data-reveal-delay="0.06">{level}</h1>
      <p class="mono listing__meta" data-reveal data-reveal-delay="0.12">
        {classes.join(' · ')} · {sorted.length} {sorted.length > 1 ? 'rendus' : 'rendu'}
      </p>
    </header>

    <ProjectGrid projects={sorted} withSubject />
  </article>

  <script>
    import { initReveal } from '../../scripts/reveal';
    initReveal();
  </script>

  <style>
    .listing {
      padding-block: clamp(3rem, 10vh, 6rem) 0;
    }
    .listing a {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }
    .listing__title {
      margin-block: 0.35em 0.3em;
      font-size: var(--step-4);
      font-weight: 500;
      line-height: 0.94;
      letter-spacing: -0.045em;
      font-variation-settings: 'wght' 500, 'wdth' 88;
    }
    .listing__meta {
      margin-bottom: clamp(3rem, 9vh, 5rem);
    }
  </style>
</Base>
