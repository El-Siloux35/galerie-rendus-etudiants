---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Les rendus des étudiants en design d’interface." } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Avant le premier rendu : évite le flash de thème et permet de
      // masquer les éléments animés uniquement si JS est bien là.
      document.documentElement.classList.add('js');

      // Filet de sécurité : les blocs [data-reveal] sont masqués en CSS et
      // c'est le script d'apparition qui les révèle. Si ce script ne
      // démarre pas (chunk bloqué, réseau coupé, erreur), la page resterait
      // vide. Au bout de trois secondes sans signe de vie, on réaffiche
      // tout : une page sans animation vaut mieux qu'une page blanche.
      setTimeout(function () {
        if (!document.documentElement.dataset.revealReady) {
          document.documentElement.classList.remove('js');
        }
      }, 3000);
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>

    <header class="site-head shell">
      <a class="site-head__name" href="/">
        Galerie de rendu en design d’interface
      </a>
      <nav class="site-head__nav">
        <a href="/ajouter">Ajouter un projet</a>
        <button type="button" id="theme-toggle" aria-pressed="false">
          <span class="visually-hidden">Passer en thème clair</span>
          <svg class="icon icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2.4v2.5M12 19.1v2.5M2.4 12h2.5M19.1 12h2.5M5.2 5.2l1.8 1.8M17 17l1.8 1.8M18.8 5.2 17 7M7 17l-1.8 1.8" />
          </svg>
          <svg class="icon icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.4 14.7A8.7 8.7 0 0 1 9.3 3.6 8.7 8.7 0 1 0 20.4 14.7Z" />
          </svg>
        </button>
      </nav>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="site-foot shell">
      <span class="mono">Travaux d’étudiants, tous droits réservés à leurs auteurs</span>
      <span class="mono">{new Date().getFullYear()}</span>
    </footer>

    <script>
      const btn = document.getElementById('theme-toggle');
      const label = btn?.querySelector('.visually-hidden');

      const describe = () => {
        if (!btn || !label) return;
        const light = document.documentElement.dataset.theme === 'light';
        btn.setAttribute('aria-pressed', String(light));
        // L'intitulé annonce la destination, pas l'état courant : c'est ce
        // que la personne obtiendra en activant le bouton.
        label.textContent = light ? 'Passer en thème sombre' : 'Passer en thème clair';
      };
      describe();

      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        describe();
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>

    <style>
      .skip {
        position: absolute;
        left: var(--gutter);
        top: -4rem;
        z-index: 100;
        padding: 0.6rem 1rem;
        background: var(--ink);
        color: var(--paper);
        transition: top 0.2s;
      }
      .skip:focus {
        top: 0.75rem;
      }

      .site-head {
        position: sticky;
        top: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 1.1rem;
        background: color-mix(in srgb, var(--paper) 82%, transparent);
        backdrop-filter: blur(14px);
        border-bottom: var(--rule) solid var(--line);
      }

      .site-head__name {
        font-size: var(--step-0);
        font-weight: 600;
        font-variation-settings: 'wght' 600, 'wdth' 88;
        letter-spacing: -0.01em;
        max-width: 22ch;
      }

      .site-head__nav {
        display: flex;
        align-items: center;
        gap: clamp(1rem, 3vw, 2rem);
      }

      .site-head__nav a {
        font-family: var(--font-mono);
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        transition: color 0.3s var(--ease);
      }

      .site-head__nav a:hover,
      #theme-toggle:hover {
        color: var(--ink);
      }

      #theme-toggle {
        /* Zone de clic confortable autour d'une icône de 18 px. */
        display: grid;
        place-items: center;
        width: 2.4rem;
        height: 2.4rem;
        margin-right: -0.5rem;
        color: var(--muted);
        background: none;
        border: 0;
        border-radius: 999px;
        cursor: pointer;
        transition: color 0.3s var(--ease);
      }

      #theme-toggle .icon {
        width: 1.125rem;
        height: 1.125rem;
      }

      /* L'icône montre la destination : soleil sur fond sombre, lune sur
         fond clair. */
      #theme-toggle .icon--moon {
        display: none;
      }
      :global(html[data-theme='light']) #theme-toggle .icon--sun {
        display: none;
      }
      :global(html[data-theme='light']) #theme-toggle .icon--moon {
        display: block;
      }

      .site-foot {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 2.5rem;
        margin-top: clamp(4rem, 12vh, 9rem);
        border-top: var(--rule) solid var(--line);
      }
    </style>
  </body>
</html>
