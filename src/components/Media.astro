---
/**
 * Affiche un média d'un rendu. Un seul composant pour tous les types :
 * le schéma Zod garantit que les champs attendus sont présents, donc
 * chaque branche peut s'écrire sans garde défensive.
 */
import type { CollectionEntry } from 'astro:content';

type MediaEntry = CollectionEntry<'projects'>['data']['media'][number];
interface Props {
  item: MediaEntry;
}
const { item } = Astro.props;

/**
 * Convertit un lien de partage Figma en lien d'intégration.
 *
 * Depuis Embed Kit 2.0, l'intégration passe par embed.figma.com et non plus
 * par figma.com/embed, et le paramètre `embed-host` est obligatoire. On garde
 * le chemin et les paramètres du lien d'origine, qui portent le point de
 * départ du prototype.
 *
 * Renvoie null si le lien n'est pas un lien Figma : on affiche alors un
 * simple bouton d'ouverture plutôt qu'un cadre vide.
 */
function toFigmaEmbed(raw: string): string | null {
  let url: URL;
  try {
    url = new URL(raw);
  } catch {
    return null;
  }
  if (url.hostname !== 'figma.com' && !url.hostname.endsWith('.figma.com')) return null;

  url.hostname = 'embed.figma.com';
  url.protocol = 'https:';
  // « file » est l'ancien nom de « design » dans les liens Figma.
  url.pathname = url.pathname.replace(/^\/file\//, '/design/');
  url.searchParams.set('embed-host', 'galerie-rendus');
  return url.toString();
}

const figmaEmbed = item.type === 'figma' ? toFigmaEmbed(item.url) : null;
---

<figure class="media">
  <figcaption class="media__head">
    <span class="mono">
      {item.label ?? (item.type === 'image' ? item.alt : item.type)}
    </span>
    {
      (item.type === 'pdf' || item.type === 'html' || item.type === 'video') && (
        <a class="mono media__out" href={item.src} target="_blank" rel="noopener">
          {item.type === 'pdf' ? 'Télécharger ↗' : 'Ouvrir ↗'}
        </a>
      )
    }
    {
      (item.type === 'figma' || item.type === 'link') && (
        <a class="mono media__out" href={item.url} target="_blank" rel="noopener">
          Ouvrir ↗
        </a>
      )
    }
  </figcaption>

  {
    item.type === 'image' && (
      <img class="media__frame" src={item.src} alt={item.alt} loading="lazy" decoding="async" />
    )
  }

  {
    item.type === 'video' && (
      <video class="media__frame" controls preload="metadata" poster={item.poster}>
        <source src={item.src} type="video/mp4" />
        <a href={item.src}>Télécharger la vidéo</a>
      </video>
    )
  }

  {
    item.type === 'pdf' && (
      <div class="pdf" data-pdf-src={item.src} data-pdf-state="loading" tabindex="0">
        <div class="pdf__stage" data-pdf-stage>
          <canvas />
        </div>
        <div class="pdf__bar">
          <button type="button" data-pdf-prev aria-label="Page précédente">
            ←
          </button>
          <span class="mono" data-pdf-counter>
            Chargement
          </span>
          <button type="button" data-pdf-next aria-label="Page suivante">
            →
          </button>
        </div>
      </div>
    )
  }

  {
    /* Rendu HTML d'étudiant : ouvert dans un onglet, pas embarqué.
       Une iframe assez isolée pour être sûre (origine opaque) casse tout
       prototype qui touche à sessionStorage, à la caméra ou au plein
       écran ; et une iframe qui les laisse passer pourrait manipuler la
       galerie, puisqu'elle est servie depuis le même domaine.
       Ces pages sont de toute façon conçues plein écran : les ouvrir
       telles quelles est aussi le meilleur moyen de les voir. */
    item.type === 'html' && (
      <a class="media__launch" href={item.src} target="_blank" rel="noopener">
        <span class="media__launch-title">Ouvrir la maquette HTML</span>
        <span class="media__launch-note">
          Le site s’ouvre dans un nouvel onglet, en plein écran.
        </span>
      </a>
    )
  }

  {
    item.type === 'figma' &&
      (figmaEmbed ? (
        <iframe
          class="media__frame media__frame--app"
          style={`aspect-ratio: ${item.ratio};`}
          src={figmaEmbed}
          title={item.label}
          loading="lazy"
          allowfullscreen
          /* Le cadre Figma peut emmener le visiteur hors de la galerie :
             une interaction dans le prototype redirige la page hôte vers
             figma.com. L'absence d'`allow-top-navigation` l'en empêche.
             `allow-same-origin` ne rend ici que son origine à Figma, qui
             reste un autre domaine que le nôtre : contrairement aux pages
             HTML d'étudiants, le cadre n'obtient aucun accès à la galerie. */
          sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-forms"
        />
      ) : (
        <a class="media__launch" href={item.url} target="_blank" rel="noopener">
          <span class="media__launch-title">Ouvrir le prototype</span>
          <span class="media__launch-note">Ce lien ne peut pas être intégré à la page.</span>
        </a>
      ))
  }

  {
    item.type === 'link' && (
      <a class="media__link" href={item.url} target="_blank" rel="noopener">
        {item.url.replace(/^https?:\/\//, '')}
      </a>
    )
  }
</figure>

<style>
  .media {
    border-top: var(--rule) solid var(--line);
    padding-top: 0.85rem;
  }

  .media__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .media__out {
    color: var(--muted);
    transition: color 0.3s var(--ease);
  }
  @media (hover: hover) {
    .media__out:hover {
      color: var(--ink);
    }
  }

  .media__frame {
    width: 100%;
    height: auto;
    border: var(--rule) solid var(--line);
    background: var(--veil);
  }

  /* Prototype Figma : pensé plein écran, donc 16/9. */
  .media__frame--app {
    aspect-ratio: 16 / 9;
    height: auto;
    display: block;
  }

  /* --- Lecteur PDF ---------------------------------------------------- */
  .pdf {
    border: var(--rule) solid var(--line);
    background: var(--veil);
  }
  .pdf:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  .pdf__stage {
    /* Remplacé par le ratio réel de la première page dès qu'elle est lue. */
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .pdf__stage canvas {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .pdf[data-pdf-state='ready'] .pdf__stage canvas {
    opacity: 1;
  }

  .pdf__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 0.7rem;
    border-top: var(--rule) solid var(--line);
  }
  .pdf__bar button {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    font-size: var(--step-1);
    color: var(--ink);
    background: none;
    border: var(--rule) solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    transition:
      border-color 0.3s var(--ease),
      opacity 0.3s var(--ease);
  }
  @media (hover: hover) {
    .pdf__bar button:hover:not(:disabled) {
      border-color: var(--line-strong);
    }
  }
  .pdf__bar button:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .pdf__bar [data-pdf-counter] {
    min-width: 6ch;
    text-align: center;
  }

  /* Le document n'a pas pu être lu : le lien de téléchargement du bandeau
     reste la porte de sortie. */
  .pdf[data-pdf-state='error'] .pdf__stage::after {
    content: 'Aperçu indisponible. Utilisez le lien de téléchargement.';
    padding: 2rem;
    text-align: center;
    color: var(--muted);
  }
  .pdf[data-pdf-state='error'] .pdf__bar {
    display: none;
  }

  .media__launch {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: clamp(2rem, 6vw, 3.5rem);
    border: var(--rule) solid var(--line);
    background: var(--veil);
    transition: background-color 0.4s var(--ease);
  }
  @media (hover: hover) {
    .media__launch:hover {
      background: color-mix(in srgb, var(--ink) 10%, transparent);
    }
  }
  .media__launch-title {
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.03em;
    font-variation-settings: 'wght' 500, 'wdth' 90;
  }
  .media__launch-note {
    color: var(--muted);
  }

  .media__link {
    display: block;
    padding: 1.2rem 0;
    font-size: var(--step-1);
    border-bottom: var(--rule) solid var(--line-strong);
  }
</style>
